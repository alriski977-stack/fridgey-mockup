# ===== Database: Supabase (untuk hosting/produksi) =====
# Dapatkan dari: Dashboard Supabase -> Project Settings -> API
SUPABASE_URL=
# Produksi: pakai service_role key (rahasia, hanya server).
# Pengembangan: boleh pakai publishable (anon) key asalkan skema RLS di
# supabase/schema.sql sudah dijalankan (berisi kebijakan izin aplikasi).
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Bucket Supabase Storage untuk foto struk/kemasan (dibuat oleh schema.sql).
SUPABASE_STORAGE_BUCKET=receipts

# Mode lokal dibantu otomatis fallback ke SQLite bila SUPABASE_URL kosong.
# Catatan: di hosting serverless foto tidak boleh disimpan ke folder lokal,
# Supabase Storage wajib aktif.

# ===== Login OTP (WAJIB diisi agar login berfungsi) =====
# Pilihan 1 - WhatsApp Cloud API:
#   OTP_PROVIDER=whatsapp_cloud
#   WHATSAPP_TOKEN=token-akses-meta
#   WHATSAPP_PHONE_ID=nomor-id-telepon
# Pilihan 2 - penyedia OTP HTTP generik:
#   OTP_API_URL=https://penyedia-otp/send
#   OTP_API_KEY=kunci-api
# Kode OTP disimpan sebagai hash (HMAC) memakai OTP_PEPPER.
OTP_PEPPER=
# Hanya untuk pengujian lokal; otomatis diabaikan saat NODE_ENV=production.
# OTP_DEV_MODE=true

# ===== Pembayaran Lynk.id =====
# Buat payment link di akun Lynk.id (lynk.id), lalu tempel URL-nya di sini.
LYNK_LINK_STARTER=https://lynk.id/awukberlima
LYNK_LINK_PRO=https://lynk.id/awukberlima
LYNK_LINK_TRIAL=

# Token webhook (opsional). Pastikan sama dengan yang diatur di dashboard Lynk.id
# -> Webhook, agar endpoint /api/payments/lynk aman.
LYNK_WEBHOOK_TOKEN=