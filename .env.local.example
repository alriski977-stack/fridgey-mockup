# ===== Database: Supabase (untuk hosting/produksi) =====
# Dapatkan dari: Dashboard Supabase -> Project Settings -> API
SUPABASE_URL=
# Produksi: pakai service_role key (rahasia, hanya server).
# Demo/dev: boleh pakai publishable (anon) key asalkan skema RLS di
# supabase/schema.sql sudah dijalankan (berisi kebijakan izin demo).
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=

# Mode lokal dibantu otomatis fallback ke SQLite bila SUPABASE_URL kosong.

# ===== Pembayaran Lynk.id =====
# Buat payment link di akun Lynk.id (lynk.id), lalu tempel URL-nya di sini.
LYNK_LINK_STARTER=https://lynk.id/awukberlima
LYNK_LINK_PRO=https://lynk.id/awukberlima
LYNK_LINK_TRIAL=

# Token webhook (opsional). Pastikan sama dengan yang diatur di dashboard Lynk.id
# -> Webhook, agar endpoint /api/payments/lynk aman.
LYNK_WEBHOOK_TOKEN=